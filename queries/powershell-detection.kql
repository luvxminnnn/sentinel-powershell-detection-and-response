SecurityEvent
| where EventID == 4688
| extend ProcessLower = tolower(Process)
| extend CommandLineLower = tolower(CommandLine)
| where ProcessLower has "powershell.exe"
    or ProcessLower has "pwsh.exe"
| extend HasEncodedCommand =
    CommandLineLower matches regex @"(?i)(-enc(odedcommand)?\s)"
| extend HasNoProfile =
    CommandLineLower contains "-noprofile"
| extend SuspiciousReason = case(
    HasEncodedCommand, "Encoded PowerShell command",
    "Other"
)
| where SuspiciousReason != "Other"
| project
    TimeGenerated,
    Computer,
    Account,
    Process,
    ParentProcessName,
    CommandLine,
    HasNoProfile,
    HasEncodedCommand,
    SuspiciousReason
| order by TimeGenerated desc
